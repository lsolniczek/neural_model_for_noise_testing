{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmm.local/schema/human_validation_trials_v1.schema.json",
  "title": "HumanValidationTrialsV1Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "experiment_id",
    "participant_id",
    "session_id",
    "trial_id",
    "condition_id",
    "stimulus_id",
    "preset_id",
    "cohort",
    "repeat_index",
    "carrier_color",
    "modulation_rate_hz",
    "modulation_depth",
    "reverb_level",
    "movement_level",
    "spl_db_a",
    "model_signature_schema_version",
    "model_signature_json",
    "legacy_v1_neural_score",
    "legacy_v1_fused_score",
    "candidate_research_v2_score",
    "product_acoustic_score",
    "aperiodic_exponent",
    "aperiodic_offset",
    "alpha_peak_frequency_hz",
    "envelope_plv",
    "assr_plv",
    "alpha_asymmetry",
    "vigilance_accuracy",
    "reaction_time_ms",
    "reaction_time_variability_ms",
    "comfort_rating",
    "irritation_rating",
    "masking_effectiveness_rating"
  ],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "participant_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "trial_id": { "type": "string", "minLength": 1 },
    "condition_id": { "type": "string", "minLength": 1 },
    "stimulus_id": { "type": "string", "minLength": 1 },
    "preset_id": { "type": "string", "minLength": 1 },
    "cohort": { "type": "string", "minLength": 1 },
    "repeat_index": { "type": "integer", "minimum": 0 },
    "carrier_color": { "type": "string", "minLength": 1 },
    "modulation_rate_hz": { "type": "number", "minimum": 0.0 },
    "modulation_depth": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "reverb_level": { "type": "number", "minimum": 0.0 },
    "movement_level": { "type": "number", "minimum": 0.0 },
    "spl_db_a": { "type": "number", "minimum": 0.0 },
    "model_signature_schema_version": { "type": "integer", "minimum": 1 },
    "model_signature_json": { "type": "string", "minLength": 1 },
    "legacy_v1_neural_score": { "type": ["number", "null"] },
    "legacy_v1_fused_score": { "type": ["number", "null"] },
    "candidate_research_v2_score": { "type": ["number", "null"] },
    "product_acoustic_score": { "type": ["number", "null"] },
    "candidate_dominant_modulation_hz": { "type": ["number", "null"], "minimum": 0.0 },
    "candidate_total_modulation_power": { "type": ["number", "null"] },
    "candidate_mod_slow_0p5_4_hz": { "type": ["number", "null"] },
    "candidate_mod_theta_4_8_hz": { "type": ["number", "null"] },
    "candidate_mod_alpha_8_13_hz": { "type": ["number", "null"] },
    "candidate_mod_beta_13_30_hz": { "type": ["number", "null"] },
    "candidate_mod_gamma_30_50_hz": { "type": ["number", "null"] },
    "candidate_gamma_response_strength": { "type": ["number", "null"] },
    "candidate_modulation_responsiveness_index": { "type": ["number", "null"] },
    "aperiodic_exponent": { "type": ["number", "null"] },
    "aperiodic_offset": { "type": ["number", "null"] },
    "alpha_peak_frequency_hz": { "type": ["number", "null"], "minimum": 0.0 },
    "envelope_plv": { "type": ["number", "null"] },
    "assr_plv": { "type": ["number", "null"] },
    "alpha_asymmetry": { "type": ["number", "null"] },
    "vigilance_accuracy": { "type": ["number", "null"] },
    "reaction_time_ms": { "type": ["number", "null"], "minimum": 0.0 },
    "reaction_time_variability_ms": { "type": ["number", "null"], "minimum": 0.0 },
    "comfort_rating": { "type": ["number", "null"] },
    "irritation_rating": { "type": ["number", "null"] },
    "masking_effectiveness_rating": { "type": ["number", "null"] }
  }
}
