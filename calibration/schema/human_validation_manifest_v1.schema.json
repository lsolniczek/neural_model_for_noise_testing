{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmm.local/schema/human_validation_manifest_v1.schema.json",
  "title": "HumanValidationManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "schema_version",
    "experiment_id",
    "protocol_version",
    "created_at",
    "study_type",
    "source_files"
  ],
  "properties": {
    "dataset_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "human_validation_v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "study_type": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "source_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "ethics_or_irb_ref": { "type": "string" }
  }
}
