{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public EEG Dataset Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "created_at", "datasets"],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "public_eeg_datasets_v1"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "name",
          "source_url",
          "license",
          "modality",
          "task",
          "participants",
          "stimulus_factors_available",
          "measures_available",
          "nmm_components_supported",
          "limitations",
          "dataset_status",
          "evidence_usable",
          "download_status",
          "adapter_status",
          "raw_adapter_status",
          "intermediate_adapter_status",
          "conversion_status",
          "expected_local_layout",
          "benchmark_ready"
        ],
        "properties": {
          "dataset_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "modality": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "participants": {"type": ["integer", "null"], "minimum": 0},
          "stimulus_factors_available": {"type": "array", "items": {"type": "string"}},
          "measures_available": {"type": "array", "items": {"type": "string"}},
          "nmm_components_supported": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "dataset_status": {
            "type": "string",
            "enum": ["selected", "placeholder"]
          },
          "evidence_usable": {"type": "boolean"},
          "download_status": {
            "type": "string",
            "enum": ["not_downloaded", "downloaded", "partial"]
          },
          "adapter_status": {
            "type": "string",
            "enum": ["not_started", "scaffold_ready", "implemented"]
          },
          "raw_adapter_status": {"type": "string", "enum": ["not_started", "implemented"]},
          "intermediate_adapter_status": {"type": "string", "enum": ["not_started", "implemented"]},
          "conversion_status": {"type": "string", "enum": ["not_started", "implemented"]},
          "expected_local_layout": {"type": "string", "minLength": 1},
          "benchmark_ready": {"type": "boolean"}
        }
      }
    }
  }
}
